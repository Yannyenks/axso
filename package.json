{
  "name": "axso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names axso,freellmapi --prefix-colors cyan,yellow \"next dev\" \"npm run dev --prefix freellmapi\"",
    "dev:axso": "next dev",
    "dev:freellmapi": "npm run dev --prefix freellmapi",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
